}

@Composable
fun MiStockApp() {

    Scaffold(
        bottomBar = {
            BottomNavigation()
        }
    ) { padding ->

        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(Color(0xFFF5F5F9))
                .padding(padding)
                .padding(16.dp)
        ) {

            // ENCABEZADO
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "☰",
                    fontSize = 26.sp
                )

                Text(
                    text = "Mi Stock",
                    fontSize = 22.sp,
                    fontWeight = FontWeight.Bold
                )

                Text(
                    text = "⋮",
                    fontSize = 28.sp
                )
            }

            Spacer(modifier = Modifier.height(16.dp))

            // RESUMEN
            Card(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(14.dp)
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(18.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {

                    Column {
                        Text(
                            text = "Resumen de stock",
                            fontSize = 17.sp,
                            fontWeight = FontWeight.Bold
                        )

                        Text(
                            text = "2 productos con stock bajo",
                            color = Color.Gray,
                            fontSize = 14.sp
                        )
                    }

                    Text(
                        text = "›",
                        fontSize = 30.sp
                    )
                }
            }

            Spacer(modifier = Modifier.height(14.dp))

            // ESTADÍSTICAS
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {

                StatCard(
                    numero = "5",
                    texto = "Productos",
                    modifier = Modifier.weight(1f)
                )

                StatCard(
                    numero = "2",
                    texto = "Bajo",
                    numeroColor = Color.Red,
                    modifier = Modifier.weight(1f)
                )

                StatCard(
                    numero = "48,66€",
                    texto = "Valor",
                    numeroColor = Color(0xFF4D7A2A),
                    modifier = Modifier.weight(1f)
                )
            }

            Spacer(modifier = Modifier.height(18.dp))

            // TÍTULO PRODUCTOS
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {

                Text(
                    text = "Productos",
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold
                )

                Button(
                    onClick = {},
                    modifier = Modifier.height(40.dp)
                ) {
                    Text("+ Añadir")
                }
            }

            Spacer(modifier = Modifier.height(8.dp))

            // PRODUCTOS
            ProductCard(
                nombre = "Agua 1L",
                cantidad = 4,
                maximo = 24,
                bajo = true
            )

            ProductCard(
                nombre = "Coca Cola",
                cantidad = 1,
                maximo = 12,
                bajo = true
            )

            ProductCard(
                nombre = "Fanta",
                cantidad = 13,
                maximo = 13,
                bajo = false
            )

            ProductCard(
                nombre = "Zumo naranja",
                cantidad = 6,
                maximo = 12,
                bajo = false
            )

            ProductCard(
                nombre = "Leche entera",
                cantidad = 8,
                maximo = 12,
                bajo = false
            )
        }
    }
}


// TARJETA DE ESTADÍSTICA
@Composable
fun StatCard(
    numero: String,
    texto: String,
    modifier: Modifier = Modifier,
    numeroColor: Color = Color.Black
) {

    Card(
        modifier = modifier,
        shape = RoundedCornerShape(12.dp)
    ) {

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(12.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            Text(
                text = numero,
                fontSize = 21.sp,
                fontWeight = FontWeight.Bold,
                color = numeroColor
            )

            Text(
                text = texto,
                fontSize = 12.sp,
                color = Color.Gray
            )
        }
    }
}


// TARJETA DE PRODUCTO
@Composable
fun ProductCard(
    nombre: String,
    cantidad: Int,
    maximo: Int,
    bajo: Boolean
) {

    var stock by remember { mutableStateOf(cantidad) }

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 4.dp),
        shape = RoundedCornerShape(12.dp)
    ) {

        Column(
            modifier = Modifier.padding(14.dp)
        ) {

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {

                Text(
                    text = nombre,
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Bold
                )

                Text(
                    text = if (stock <= 2) "Muy bajo stock" else "Stock completo",
                    fontSize = 12.sp,
                    color = if (stock <= 2) Color.Red else Color(0xFF4D7A2A)
                )
            }

            Spacer(modifier = Modifier.height(8.dp))

            // BARRA DE PROGRESO SIMPLE
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {

                Text(
                    text = "━━━━━━",
                    color = if (stock <= 2) Color.Red else Color(0xFF4D7A2A),
                    fontSize = 14.sp,
                    modifier = Modifier.weight(1f)
                )

                Text(
                    text = "$stock/$maximo",
                    fontSize = 12.sp,
                    color = Color.Gray
                )

                Spacer(modifier = Modifier.size(8.dp))

                TextButton(
                    onClick = {
                        if (stock > 0) stock--
                    }
                ) {
                    Text("−")
                }

                Text(
                    text = "$stock",
                    fontWeight = FontWeight.Bold
                )

                TextButton(
                    onClick = {
                        if (stock < maximo) stock++
                    }
                ) {
                    Text("+")
                }
            }
        }
    }
}


// NAVEGACIÓN INFERIOR
@Composable
fun BottomNavigation() {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .background(Color.White)
            .padding(vertical = 12.dp),
        horizontalArrangement = Arrangement.SpaceEvenly
    ) {

        Text(
            text = "⌂\nInicio",
            fontSize = 13.sp,
            textAlign = androidx.compose.ui.text.style.TextAlign.Center
        )

        Text(
            text = "◷\nHistorial",
            fontSize = 13.sp,
            textAlign = androidx.compose.ui.text.style.TextAlign.Center
        )

        Text(
            text = "⚙\nConfiguración",
            fontSize = 13.sp,
            textAlign = androidx.compose.ui.text.style.TextAlign.Center
        )
    }
}
